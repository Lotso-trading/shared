{
    "branches": [
        "main",
        {
            "name": "develop",
            "prerelease": "develop",
            "channel": "dev"
        }
    ],
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "preset": "conventionalcommits",
                "releaseRules": [
                    { "type": "feat", "release": "minor" },
                    { "type": "fix", "release": "patch" },
                    { "type": "perf", "release": "patch" },
                    { "type": "refactor", "release": "patch" },
                    { "scope": "deps", "release": "patch" },
                    { "type": "chore", "scope": "deps", "release": "patch" }
                ]
            }
        ],
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "deno task build:npm --version ${nextRelease.version}",
                "publishCmd": "cd npm && if [ \"${nextRelease.channel}\" = \"dev\" ] || [ \"$GITHUB_REF_NAME\" = \"develop\" ]; then npm publish --tag dev; else npm publish --tag latest; fi"
            }
        ],
        "@semantic-release/github"
    ]
}
